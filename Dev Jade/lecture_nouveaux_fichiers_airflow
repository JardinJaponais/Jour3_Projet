import boto3
from boto3.session import Session
import os
import pandas as pd
from io import StringIO
from sqlalchemy import create_engine
from sqlalchemy import text

# Créer une session boto3 avec les paramètres MinIO
session = Session(
    aws_access_key_id="studentSDV",
    aws_secret_access_key="coucou44",
)

# Créer un client S3 pointant vers MinIO
s3 = session.client(
    service_name="s3",
    endpoint_url= "http://51.77.215.42:9010",
)

# Variables
bucket_name = "wintershoplogs"
local_dir = "Bronze"

# Point de départ
# lister tous les fichiers access_ dans Bronze
files = [f for f in os.listdir(local_dir) if f.startswith("access_")]

if files:
    # le max lexicographique = fichier le plus récent
    latest_file = max(files)
    print("Fichier le plus récent :", latest_file)
else:
    latest_file = None
    print("Aucun fichier dans Bronze")

# lister les fichiers du bucket
response = s3.list_objects_v2(Bucket=bucket_name)

files_to_download = []

if "Contents" in response:
    for obj in response["Contents"]:
        file_key = obj["Key"]
        file_name = os.path.basename(file_key)

        # On ne prend que les fichiers >= START_FILE
        if file_name >= latest_file:
            files_to_download.append(file_key)
else:
    print("Aucun fichier trouvé")

all_logs = []

for file_key in files_to_download:
    file_name = os.path.basename(file_key)
    local_path = os.path.join(local_dir, file_name)

    # Télécharger si pas déjà présent
    if not os.path.exists(local_path):
        s3.download_file(bucket_name, file_key, local_path)
        print(f"Téléchargé : {file_name}")
    else:
        print(f"Déjà présent : {file_name}")

    # Lire le fichier dans un DataFrame
    # On suppose que le log est CSV ou texte séparé par un espace ou tab
    df = pd.read_csv(local_path, sep="🎭", header=None, engine='python')  # adapter le sep si nécessaire
    all_logs.append(df)

# Concaténer tous les fichiers
if all_logs:
    df_all = pd.concat(all_logs, ignore_index=True)
    print(f"Total lignes : {len(df_all)}")
else:
    df_all = pd.DataFrame()
    print("Aucun log à traiter")

# mettre en df puis dans la bdd
# PostgreSQL
DB_USER = "postgres"
DB_PASSWORD = "1234"
DB_HOST = "10.18.72.74"
DB_PORT = "5432"
DB_NAME = "postgres"
SCHEMA = "Jade_DEV"
TABLE_NAME = "logs_access"

if not df_all.empty:
    # Connexion SQLAlchemy
    engine = create_engine(f"postgresql+psycopg2://{DB_USER}:{DB_PASSWORD}@{DB_HOST}:{DB_PORT}/{DB_NAME}")
    
    with engine.begin() as conn:  # begin() = transaction + commit automatique
        conn.execute(text(f"CREATE SCHEMA IF NOT EXISTS {SCHEMA};"))
        conn.commit()

    # Écrire dans PostgreSQL
    df_all.to_sql(name=TABLE_NAME, con=engine, schema=SCHEMA, if_exists="append", index=False)
    print(f"Données insérées dans {SCHEMA}.{TABLE_NAME}")

# recalculer le latest file
files = [f for f in os.listdir(local_dir) if f.startswith("access_")]

if files:
    # le max lexicographique = fichier le plus récent
    latest_file = max(files)
    print("Fichier le plus récent :", latest_file)
else:
    latest_file = None
    print("Aucun fichier dans Bronze")

for f in os.listdir(local_dir):
    file_path = os.path.join(local_dir, f)

    # Vérifie que c'est bien un fichier
    if os.path.isfile(file_path) and f != latest_file:
        os.remove(file_path)
    else:
        print(f"Gardé : {f}")